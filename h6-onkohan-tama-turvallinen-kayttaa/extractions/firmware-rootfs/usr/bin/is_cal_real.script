#!/bin/sh

VERIFY_ADDR=0x100  VERIFY_LEN=2
MAC_ADDR=0xD7      MAC_LEN=6
DEVID_ADDR=0xEA    DEVID_LEN=20
REGION_ADDR=0xFE   REGION_LEN=2
MULTI_MODEL_ADDR=0xDD MULTI_MODEL_LEN=3
MODEL_ADDR=0xE0       MODEL_LEN=10
FACTORY_DATA_FILE="/tmp/.factory_info"
is_write=0
is_write_mac=0
is_write_devid=0

# read_e2prom addr len [seperator], return: 10B23CE0F7A8...
read_e2prom()
{
	iwpriv wlan0 efuse_get rmap,$1,$2 2>/dev/null | cut -d: -f2 | sed -e "s/^0x//g;s/[[:space:]]\+$//g;s/[[:space:]]\+0x/$3/g"
}

# write_e2prom addr data, return: NULL
write_e2prom()
{
	iwpriv wlan0 efuse_set wmap,$1,$2 >/dev/null
}


# hextochar 545053..., return: TPO...
hextochar()
{
	i=0
	while [ $i -lt ${#1} ]
	do
		printf "\x${1:$i:2}"
		i=$((i+2))
	done
}

getFactoryInfo()
{
	ubus call tddpServer getInfo "{\"infoMask\":65535}" > $FACTORY_DATA_FILE
}

# getInfo type, return data
getInfo()
{
	cat $FACTORY_DATA_FILE | awk -F$1 '{ print $2 }' | awk -F\" '{print $3}'
}

# setInfo type data
setInfo()
{
	ubus call tddpServer setInfo "{\"type\":$1, \"data\":\"$2\"}"
}

ifconfig wlan0 > /dev/null 2>&1
rc=$?

while [ $rc -ne 0 ]; do
	echo "[is_cal] wlan-manager: driver is not ready, wait..." > /dev/console
	sleep 1s
	ifconfig wlan0 > /dev/null 2>&1
	rc=$?
done

# echo "[is_cal] !!!! wlan-manager: driver ready........" >/dev/console

while [ -z "$(read_e2prom 0x00 1)" ]
do
	sleep 1
done

# echo "[is_cal] !!!! e2prom ready........" >/dev/console

verify_val=`read_e2prom $VERIFY_ADDR $VERIFY_LEN`
verify_val=`hextochar $verify_val`

if [ "$verify_val" = "TP" -o "$verify_val" = "UP" ]; then
	getFactoryInfo
	mac_old=`getInfo mac`
	devid_old=`getInfo dev_id`
	region_old=`getInfo region`
	oemid_old=`getInfo oem_id`
	devname_old=`getInfo dev_name`
	c=0
	while [ "$mac_old" == "" ]
	do
		sleep 1
		getFactoryInfo
		mac_old=`getInfo mac`
		devid_old=`getInfo dev_id`
		region_old=`getInfo region`
		oemid_old=`getInfo oem_id`
		devname_old=`getInfo dev_name`
		c=$((c+1))
		[ $c -gt 3 ] && break
	done

	mac_val=`read_e2prom $MAC_ADDR $MAC_LEN -`
	devid_val=`read_e2prom $DEVID_ADDR $DEVID_LEN`
	region_val=`read_e2prom $REGION_ADDR $REGION_LEN`
	region_val=`hextochar $region_val`
	multi_model_flag=`read_e2prom $MULTI_MODEL_ADDR $MULTI_MODEL_LEN`
	if [ "${multi_model_flag:0:2}" = "3D" ]; then
		model_data=`read_e2prom $MODEL_ADDR $MODEL_LEN`
		model_len="${model_data:1:1}"
		model_len=$((model_len*2))

		if [ "$model_len" != "0" -a $model_len -le 18 ]; then
			model_val="${model_data:2:$model_len}"
			model_val=`hextochar $model_val`
			hw_ver="${multi_model_flag:4:1}.${multi_model_flag:5:1}"
		fi
		oemid_val=`awk -F: -v r=$model_val'('$region_val')' '$1==r{print $2}' /etc/oem_id.bin`
		devname_val="$model_val $hw_ver"
	else
		if [ ! -z "$devname_old" ]; then
			flash_model=${devname_old% *}
			oemid_val=`awk -F: -v r=$flash_model'('$region_val')' '$1==r{print $2}' /etc/oem_id.bin`
			if [ -z "$oemid_val" ]; then
				oemid_val=`awk -F: -v r=$region_val '$1==r{print $2}' /etc/oem_id.bin`
			fi
		else
			oemid_val=`awk -F: -v r=$region_val '$1==r{print $2}' /etc/oem_id.bin`
		fi
		devname_val=$devname_old
	fi

	if [ -z "$oemid_val" ]; then
		echo "[is_cal] !!!! ERROR !!!! OEM_ID is empty REGION_VAL=$region_val" >/dev/console
		oemid_val=$oemid_old
	fi

	if [ "$mac_val" = "FF-FF-FF-FF-FF-FF" -o "$mac_val" = "00-00-00-00-00-00" ]; then
		echo "[is_cal] wireless is cal, but not write mac" >/dev/console
	elif [ "$mac_val" = "00-FF-FF-FF-FF-FF" ]; then
		echo "[is_cal] abnormal mac 00-FF-FF-FF-FF-FF, do nothing" >/dev/console
	elif [ "$mac_val" != "$mac_old" ]; then
		echo "[is_cal] get old MAC: $mac_old" >/dev/console
		echo "         set new MAC: $mac_val" >/dev/console
		setInfo 1 $mac_val
		is_write=1
		is_write_mac=1
	fi

	if [ "$devid_val" != "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF" -a \
		"$devid_val" != "0000000000000000000000000000000000000000" -a \
		"$devid_val" != "$devid_old" ]; then
		echo "[is_cal] get old DEV_ID: $devid_old" >/dev/console
		echo "         set new DEV_ID: $devid_val" >/dev/console
		setInfo 3 $devid_val
		is_write=1
		is_write_devid=1
	fi

	if [ "$region_val" != "$region_old" ]; then
		echo "[is_cal] get old REGION: $region_old" >/dev/console
		echo "         set new REGION: $region_val" >/dev/console
		setInfo 14 $region_val
		is_write=1
	fi

	if [ "$oemid_val" != "$oemid_old" ]; then
		echo "[is_cal] get old OEM_ID: $oemid_old" >/dev/console
		echo "         set new OEM_ID: $oemid_val" >/dev/console
		setInfo 13 $oemid_val
		is_write=1
	fi

	if [ "$devname_val" != "$devname_old" ]; then
		echo "[is_cal] get old DEV_NAME: $devname_old" >/dev/console
		echo "         set new DEV_NAME: $devname_val" >/dev/console
		setInfo 7 "$devname_val"
		is_write=1
	fi

	if [ $is_write = 1 ]; then
		getFactoryInfo
		mac_new=`getInfo mac`
		devid_new=`getInfo dev_id`
		region_new=`getInfo region`
		oemid_new=`getInfo oem_id`

		if [ $is_write_mac = 1 ]; then
			if [ "$mac_val" != "$mac_new" ]; then
				echo "[is_cal] write mac error, do not reboot" > /dev/console
				exit 3
			else
				echo "[is_cal] sync mac success" >/dev/console
			fi
		fi

		if [ $is_write_devid = 1 ]; then
			if [ "$devid_val" != "$devid_new" ]; then
				echo "[is_cal] write deviceID error, do not reboot" > /dev/console
				exit 3
			else
				echo "[is_cal] sync deviceID success" >/dev/console
			fi
		fi

		if [ "$region_val" != "$region_new" -o "$oemid_val" != "$oemid_new" ]; then
			echo "[is_cal] write factory_info sector error, do not reboot" > /dev/console
			exit 3
		else
			echo "[is_cal] wireless is cal" >/dev/console
			#reboot;
		fi
	else
		echo "[is_cal] wireless is cal, and check success" >/dev/console
	fi
	rm $FACTORY_DATA_FILE
else
	exit 1
fi

exit 0

