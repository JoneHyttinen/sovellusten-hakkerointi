#!/bin/sh
# ÈÄöËøáÂèëÈÄÅDMSÊ∂àÊÅØÁöÑÊñπÂºèÈÄöÁü•capÁöÑsd_cardÊ®°ÂùóÂ§ÑÁêÜ‰∫ã‰ª∂
# index‰ª£Ë°®SDÂç°Á¥¢ÂºïÔºåÂΩìÂâç‰ªÖÊîØÊåÅ‰∏Ä‰∏™SDÂç°ÊßΩÔºåÈªòËÆ§‰∏∫1
# status‰ª£Ë°®ÊèíÊãîÁä∂ÊÄÅ

[ "$DEVNAME" != "mmcblk0" ] && return 0

deal_ethernet_driver() {
	killall handle_factory_mode_network
	handle_factory_mode_network &
}

case "$ACTION" in
	add)
		echo "disk on" > /dev/console
		ubus call sd_card plug_status '{"index":1, "status":1}'

		sleep 1
		deal_ethernet_driver
		;;
	remove)
		echo "disk off" > /dev/console
		ubus call sd_card plug_status '{"index":1, "status":0}'
		;;
esac


[ "$ACTION" = add ] && {
	[ "$DEVPATH" != "${DEVPATH#*usb}" ] && {
		if [ "$INTERFACE" = "eth0" -o "$INTERFACE" = "eth1" ]; then
			MAC_conf=$(uci get device_info.info.mac | tr - :)
			MAC_br=$(ifconfig br-wan | awk '$1=="br-wan"{print $5}')
			c=0
			while [ "$MAC_br" != "$MAC_conf" ]
			do
				c=$((c+1))
				[ $c -gt 3 ] && { ifconfig br-wan hw ether $MAC_conf ; break ; }
				echo "======br-wan MAC is wrong, wait" >/dev/console
				sleep 1
				MAC_conf=$(uci get device_info.info.mac|tr - :)
				MAC_br=$(ifconfig br-wan | awk '$1=="br-wan"{print $5}')
			done
			ifconfig | grep $INTERFACE && ifconfig $INTERFACE down
			ifconfig $INTERFACE hw ether $MAC_br
			ifconfig $INTERFACE up
			brctl addif br-wan $INTERFACE
			MAC_if=$(ifconfig $INTERFACE| awk -v i=$INTERFACE 'BEGIN{}{if($1==i){print $5}}')
			if [ "$MAC_br" != "$MAC_if" ]; then
				echo "======$INTERFACE MAC is wrong : $MAC_if, now set to $MAC_br" >/dev/console
				ifconfig $INTERFACE down
				ifconfig $INTERFACE hw ether $MAC_br
				ifconfig $INTERFACE up
			fi
			arping -b -I br-wan -w 1 -c 3 $(ifconfig br-wan | awk -F: '$1~"inet addr"{print $2}'|awk '{print $1}') &
		fi
	}
}


[ "$ACTION" = add ] && {

	if [ "$INTERFACE" = "esp0" ]; then
		MAC_conf=$(uci get device_info.info.mac | tr - :)
		MAC_br=$(ifconfig br-wan | awk '$1=="br-wan"{print $5}')
		c=0
		while [ "$MAC_br" != "$MAC_conf" ]
		do
			c=$((c+1))
			[ $c -gt 3 ] && { ifconfig br-wan hw ether $MAC_conf ; break ; }
			echo "======br-wan MAC is wrong, wait" >/dev/console
			usleep 1000
			MAC_conf=$(uci get device_info.info.mac|tr - :)
			MAC_br=$(ifconfig br-wan | awk '$1=="br-wan"{print $5}')
		done
		echo "======$INTERFACE init" >/dev/console
		while [ "$(ifconfig | grep -ci $INTERFACE)" -eq 0 ]
		do
			ifconfig $INTERFACE up
			usleep 1000
		done
		ifconfig | grep $INTERFACE && ifconfig $INTERFACE down
		ifconfig $INTERFACE hw ether $MAC_br
		ifconfig $INTERFACE up
		brctl addif br-wan $INTERFACE
		MAC_if=$(ifconfig $INTERFACE| awk -v i=$INTERFACE 'BEGIN{}{if($1==i){print $5}}')
		if [ "$MAC_br" != "$MAC_if" ]; then
			echo "======$INTERFACE MAC is wrong : $MAC_if, now set to $MAC_br" >/dev/console
			ifconfig $INTERFACE down
			ifconfig $INTERFACE hw ether $MAC_br
			ifconfig $INTERFACE up
		fi
		arping -b -I br-wan -w 1 -c 3 $(ifconfig br-wan | awk -F: '$1~"inet addr"{print $2}'|awk '{print $1}') &
	fi
}


#!/bin/sh

# Copyright (C) 2019 TPLINK

case "$ACTION" in
        plug-in)
                ubus call wan_status phy_status '{"status":1}'
                echo -e "===>hotplug_ethernet in" > /dev/console
                ;;
        plug-out)
                ubus call wan_status phy_status '{"status":0}'
                echo -e "===>hotplug_ethernet out" > /dev/console
                ;;
esac

# uncomment me to log hotplug events
# DEVPATH is set {
# 	exec logger -s -t hotplug -p daemon.info "name=%DEVNAME%, path=%DEVPATH%"
# }

$include /etc/hotplug2-platform.rules

DEVNAME ~~ (^null$|^full$|^ptmx$|^zero$|^gpio|^hvc) {
	makedev /dev/%DEVNAME% 0666
	next-event
}

DEVNAME == mapper/control {
	makedev /dev/%DEVNAME% 0600
	next-event
}

ACTION == add, DEVPATH is set {
	makedev /dev/%DEVNAME% 0644
}

ACTION == add, DEVPATH is set, DEVNAME ~~ ^tty {
	chmod 0666 /dev/%DEVNAME%
}

ACTION == add, DEVPATH is set, DEVNAME ~~ ^ppp {
	chmod 0600 /dev/%DEVNAME%
}

ACTION == remove, DEVPATH is set, MAJOR is set, MINOR is set {
	remove /dev/%DEVNAME%
}

FIRMWARE is set, ACTION == add {
	exec /sbin/hotplug-call firmware
	load-firmware /lib/firmware
	next-event
}

SUBSYSTEM == platform {
	exec /sbin/hotplug-call %SUBSYSTEM%
}
$include /etc/hotplug2-common.rules

$include /etc/hotplug2-common.rules

SUBSYSTEM ~~ (^net$|^input$|^button$|^usb$|^ieee1394$|^block$|^atm$|^zaptel$|^tty$) {
	exec /sbin/hotplug-call %SUBSYSTEM%
}

#!/bin/sh /etc/rc.common
# Copyright (c) 2014-2015 TP-LINK Technologies CO.,LTD.
# Copyright (c) 2013 Qualcomm Atheros, Inc.
# Copyright (C) 2006-2011 OpenWrt.org

START=05

load_modules() {
	[ -d /etc/modules.d ] && {
		cd /etc/modules.d
		sed 's/^[^#]/insmod &/' $* | ash 2>&- || :
	}
}

zram_enable() {
	[ ! -e /sys/block/zram0 ] && return 0
	echo 16777216 > /sys/block/zram0/disksize
	mkswap /dev/zram0
	swapon /dev/zram0
	echo 100 > /proc/sys/vm/swappiness
}

start() {
	zram_enable
	mkdir -p /var/run
	mkdir -p /var/log
	mkdir -p /var/lock
	mkdir -p /tmp/usbdisk
	touch /var/log/wtmp
	touch /var/log/lastlog
	touch /tmp/resolv.conf.auto
	ln -sf /tmp/resolv.conf.auto /tmp/resolv.conf
	grep -q debugfs /proc/filesystems && mount -t debugfs debugfs /sys/kernel/debug

	load_modules /etc/modules.d/*

	killall -q hotplug2
	[ -x /sbin/hotplug2 ] && /sbin/hotplug2 --override --persistent \
			--set-rules-file /etc/hotplug2.rules \
			--set-coldplug-cmd /sbin/udevtrigger \
			--max-children 1 >/dev/null 2>&1 &

	# create /dev/root if it doesn't exist
	[ -e /dev/root -o -h /dev/root ] || {
		rootdev=$(awk 'BEGIN { RS=" "; FS="="; } $1 == "root" { print $2 }' < /proc/cmdline)
		[ -n "$rootdev" ] && ln -s "$rootdev" /dev/root
	}

}

#!/bin/sh /etc/rc.common
# Copyright (C) 2008-2012 OpenWrt.org

START=20

start() {
