#!/bin/sh

mount() {
    /bin/busybox mount -o noatime "$@"
}

mount_tmpfs() {
    mount -t tmpfs -o mode=0755 root /overlay
}

mount_sp_rom() {
    spdev=$(awk 'BEGIN { RS=" "; FS="="; } $1 == "spdev" { print $2 }' < /proc/cmdline)
    if [ "$spdev" != "" ]; then
        mount -t squashfs -o relatime $spdev /sp_rom
    fi
}

pivot() { # <new_root> <old_root>
	mount -o move /proc $1/proc && \
	pivot_root $1 $1$2 && {
		mount -o move $2/dev /dev
		mount -o move $2/tmp /tmp
		mount -o move $2/sys /sys 2>&-
		mount -o move $2/overlay /overlay 2>&-
		mount | grep -q "/sp_rom" || touch /tmp/recovery_mode
		return 0
	}
}

fopivot() { # <rw_root> <ro_root>
	if [ -e /proc/cmdline ]; then
		kernel_major_version=$(uname -r|awk -F. '{print $1}')
		if [ "$kernel_major_version" = "4" ] || [ "$kernel_major_version" = "5" ]; then
			mkdir -p $1/root $1/work
			mount | grep -q "/sp_rom" \
			&& mount -o noatime,lowerdir=/sp_rom:/,upperdir=$1/root,workdir=$1/work -t overlay "overlayfs:$1" /mnt \
			|| mount -o noatime,lowerdir=/,upperdir=$1/root,workdir=$1/work -t overlay "overlayfs:$1" /mnt
		else
			mount | grep -q "/sp_rom" && {
				mount -o noatime,lowerdir=/,upperdir=/sp_rom -t overlayfs "overlayfs:$1" /mnt
				mount -o noatime,lowerdir=/mnt,upperdir=$1 -t overlayfs "overlayfs:$1" /mnt
			} || mount -o noatime,lowerdir=/,upperdir=$1 -t overlayfs "overlayfs:$1" /mnt
		fi
	fi
    pivot /mnt $2
}

do_move_devtmpfs() {
    local mnt="$(grep devtmpfs /proc/mounts)"
          mnt="${mnt#* }"; mnt="${mnt%% *}"

    [ "$mnt" = "/dev" ] || mount -o move "$mnt" /dev
}

mount_essential_fs() {
    mount proc /proc -t proc
    mount sysfs /sys -t sysfs
    pi_size=$(awk '/MemTotal:/ {l=5242880;mt=($2*1024);print((s=mt/2)<l)&&(mt>l)?mt-l:s}' /proc/meminfo)
    mount tmpfs /tmp -t tmpfs -o size=$pi_size,nosuid,nodev,mode=1777
}

mount_device_fs() {
    if grep -q devtmpfs /proc/mounts; then
        do_move_devtmpfs
	else
        mount -t tmpfs tmpfs /dev -o mode=0755,size=512K
    fi
}

init_hotplug2() {
    if [ -e /sbin/hotplug2 ]; then
        [ -c /dev/console ] || mknod /dev/console c 5 1
        /sbin/hotplug2 --set-worker /lib/hotplug2/worker_fork.so --set-rules-file /etc/hotplug2-init.rules --no-persistent --set-coldplug-cmd /sbin/udevtrigger
        /sbin/hotplug2 --set-worker /lib/hotplug2/worker_fork.so --set-rules-file /etc/hotplug2-init.rules --persistent &
        echo "" > /proc/sys/kernel/hotplug
    else
        echo "hotplug2 not found" > /dev/console
    fi
}

init_shm() {
    [ -d /dev/shm ] || mkdir -p /dev/shm
}

mount_devpts() {
    [ -d /dev/pts ] || mkdir -p /dev/pts
    mount devpts /dev/pts -t devpts
}

init_console() {
	exec </dev/console >/dev/console 2>&0
}

mount_jffs2() {
	mkdir -p /tmp/usr_def_audio
	mount -t jffs2 /dev/mtdblock8 /tmp/usr_def_audio
}

mount_root() {
    mount_tmpfs
    mount_sp_rom
    fopivot /overlay /rom
}

# insmod_trk() source is nvmp/tp_package/lib/libtrk/src/files/bin/trk_ctl.sh
insmod_trk() {
    dir=/lib/modules/$(uname -r)
    mod=ktrk.ko
    path=/dev/mtd1
    keyword=devId
    devId=`cat $path | grep $keyword | awk -F '\"'$keyword'\":\"' '{print $2}' | awk -F '\",' '{print $1}' | cut -d\" -f1`
    if [ ! -e $path ]; then
        echo $path" not found."
        return;
    fi
    if [ ! -e ${dir}/${mod} ]; then
        echo $mod" not found."
        return;
    fi
    if [ -z $devId ]; then
        echo "devId is null"
    else
        mknod /dev/derive_key c 229 0
        insmod ${dir}/${mod} deviceid=$devId
    fi
}

run_init() {
    exec env - PATH="/bin:/sbin:/usr/bin:/usr/sbin" "/sbin/init" 2>&0
}

mount_essential_fs
mount_device_fs
init_hotplug2
insmod_trk
init_shm
mount_devpts
init_console
mount_root
run_init

#!/bin/sh
[ -f /etc/banner ] && cat /etc/banner

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=$(grep -e "^${USER:-root}:" /etc/passwd | cut -d ":" -f 6)
export HOME=${HOME:-/root}
export PS1='\u@\h:\w\$ '

[ -x /bin/more ] || alias more=less
[ -x /usr/bin/vim ] && alias vi=vim || alias vim=vi

[ -z "$KSH_VERSION" -o \! -s /etc/mkshrc ] || . /etc/mkshrc

[ -x /sbin/arp ] || arp() { cat /proc/net/arp; }
[ -x /usr/bin/ldd ] || ldd() { LD_TRACE_LOADED_OBJECTS=1 $*; }
